{
  "manifest_version": 3,
  "name": "Firefly API Companion",
  "version": "1.0.0",
  "description": "Session capture, incognito verification & cloud synchronizer for Firefly API.",
  "minimum_chrome_version": "116",
  "incognito": "spanning",
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.adobe.com/*",
    "*://*.adobelogin.com/*",
    "*://*.services.adobe.com/*",
    "*://*.identity.adobe.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "action": {
    "default_title": "Firefly API Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
